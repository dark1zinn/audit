# Copy to .env for local development (Bun loads it automatically).
AUDIT_URL=http://localhost:3000
DATABASE_URL=postgres://audit:audit@127.0.0.1:5432/audit
# 32+ random bytes, e.g. `openssl rand -base64 48`
AUDIT_SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef
LOG_LEVEL=debug
# Docker compose only (deploy/compose.yml): the Postgres owner login and the server's app login.
# POSTGRES_PASSWORD=
# APP_DB_PASSWORD=
